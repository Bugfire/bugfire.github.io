{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"posts":2,"single":12,"page":13,"total":13,"previous":14,"next":14,"path":15,"tags":16,"months":62},"Archive: 2017/10",[3],{"title":4,"date":5,"day":6,"tags":7,"summary":9,"symbol":10,"html":11},"Disk Checker","2017-10-08T13:57:26.000Z","2017-10-08",[8],"Node.js","SDカードのフィルと検査","2017/10/08/diskchecker","\u003Cp>ドライブレコーダー用にMicroSDを何枚か買いました。SDカード系って偽物とかありますよね。自分は信頼できる店でしか買わないのでひっかかったこととかないつもりですが...。\u003C/p>\n\u003Cp>チェックするツールもWindows用でいくつか検索で見つけることができますが、色々と面倒なので低機能なものを作ってみました。\u003C/p>\n\u003Cul>\n\u003Cli>node.jsで200行未満\u003C/li>\n\u003Cli>ディスクが一杯になるまで指定ディレクトリに再現可能な乱数系列の256MBのファイルを作成し続ける\u003C/li>\n\u003Cli>ディスクが一杯になったら、作成したファイルを検証する\u003C/li>\n\u003Cli>ついでに読み込み・書き込み速度を測る\u003C/li>\n\u003C/ul>\n\u003Cp>低レベルで検査しているわけではないので、全エリアはチェックしていません(256MB未満の残り領域、アライメント部分、ディレクトリ情報等)。デバイスファイルを使えばできますが、オペミス怖いしそこまでやらなくてもいいと思いましたのでこのような実装にしました。\u003C/p>\n\u003Cp>\u003Ca href=\"https://github.com/Bugfire/diskchecker.git\">https://github.com/Bugfire/diskchecker.git\u003C/a> にあります。\u003C/p>\n",false,1,"","archives/2017/10",[17,21,25,28,31,34,37,41,44,47,50,53,56,59],{"label":18,"count":19,"path":20},"Diary",3,"blog/tags/Diary",{"label":22,"count":23,"path":24},"Docker",4,"blog/tags/Docker",{"label":26,"count":13,"path":27},"Frigate","blog/tags/Frigate",{"label":29,"count":13,"path":30},"Hexo","blog/tags/Hexo",{"label":8,"count":32,"path":33},2,"blog/tags/Node.js",{"label":35,"count":19,"path":36},"Proxmox","blog/tags/Proxmox",{"label":38,"count":39,"path":40},"QNAP",6,"blog/tags/QNAP",{"label":42,"count":13,"path":43},"React","blog/tags/React",{"label":45,"count":13,"path":46},"Study","blog/tags/Study",{"label":48,"count":13,"path":49},"TypeScript","blog/tags/TypeScript",{"label":51,"count":39,"path":52},"Unity","blog/tags/Unity",{"label":54,"count":13,"path":55},"VRM","blog/tags/VRM",{"label":57,"count":23,"path":58},"Web","blog/tags/Web",{"label":60,"count":13,"path":61},"WebRtc","blog/tags/WebRtc",[63,66,69,72,75,78,81,