{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"posts":2,"single":12,"page":13,"total":13,"previous":14,"next":15,"path":10,"tags":16,"months":54},"React",[3],{"title":1,"date":4,"day":5,"tags":6,"summary":9,"symbol":10,"html":11},"2019-09-26T15:00:00.000Z","2019-09-27",[1,7,8],"TypeScript","Web","長いお休みをいただいているので、練習がてら、このサイト(Bugfire.dev)を React で SPA/PWA 化しました","2019/09/27/React","\u003Ch2>SPA\u003C/h2>\n\u003Cp>長いお休みをいただいているので、練習がてら、このサイト(Bugfire.dev)を React で SPA/PWA 化しました。\u003C/p>\n\u003Cp>Page は gh-pages でホストをして、Blog は Markdown にして、index と記事を json でホストして取りに行くようにしました。\u003C/p>\n\u003Cp>Redux/Flux 的なことは Unity や Vue.js で少しかじりましたが、今回は端折りました。\u003Cbr>というか色々端折っても三日かかりました、難しい。\u003C/p>\n\u003Ch3>TODO\u003C/h3>\n\u003Cul>\n\u003Cli>\u003Cinput checked=\"\" disabled=\"\" type=\"checkbox\"> \u003Cp>Year/Month/Tag で絞り込むUI\u003C/p>\n\u003C/li>\n\u003Cli>\u003Cinput disabled=\"\" type=\"checkbox\"> \u003Cp>Android でアイコンが丸くならない、困った。\u003C/p>\n\u003Cp>&quot;purpose&quot;: &quot;maskable&quot; で良いとの記事を見たが動かない。\u003Cbr>十分透過な画像を食わせると良いとは読んだけど、それやると iOS が変になりそう。\u003C/p>\n\u003C/li>\n\u003Cli>\u003Cp>\u003Cinput checked=\"\" disabled=\"\" type=\"checkbox\"> Markdown (Code highlight)\u003C/p>\n\u003C/li>\n\u003Cli>\u003Cp>\u003Cinput checked=\"\" disabled=\"\" type=\"checkbox\"> atom.xml\u003C/p>\n\u003C/li>\n\u003Cli>\u003Cp>\u003Cinput checked=\"\" disabled=\"\" type=\"checkbox\"> sitemap.xml\u003C/p>\n\u003C/li>\n\u003C/ul>\n\u003Ch3>10/1 追記\u003C/h3>\n\u003Cp>PWA は色々おかしい(難しい)ので serviceWorker を止めました。MarkDown も single back-quote が div 要素になったり、普通に hatena blog や qiita にかけば良いのでは？、と頭をよぎってしまうので、あまり時間をかけないようにしたい(自戒)。\u003C/p>\n\u003Cp>自分のためのコードを書くのは楽しいですけどね。\u003C/p>\n",true,1,"2019/09/30/DockerComposeOnQnap","2019/02/28/VRMViewer1",[17,21,25,28,31,35,37,40,42,46,49,51],{"label":18,"count":19,"path":20},"Diary",2,"blog/tags/Diary",{"label":22,"count":23,"path":24},"Docker",4,"blog/tags/Docker",{"label":26,"count":13,"path":27},"Hexo","blog/tags/Hexo",{"label":29,"count":19,"path":30},"Node.js","blog/tags/Node.js",{"label":32,"count":33,"path":34},"QNAP",5,"blog/tags/QNAP",{"label":1,"count":13,"path":36},"blog/tags/React",{"label":38,"count":13,"path":39},"Study","blog/tags/Study",{"label":7,"count":13,"path":41},"blog/tags/TypeScript",{"label":43,"count":44,"path":45},"Unity",6,"blog/tags/Unity",{"label":47,"count":13,"path":48},"VRM","blog/tags/VRM",{"label":8,"count":23,"path":50},"blog/tags/Web",{"label":52,"count":13,"path":53},"WebRtc","blog/tags/WebRtc",[55,58,62,65,68,71,74,77,80,83],{"label":56,"count":13,"path":57},"2020/02","archives/2020/02",{"label":59,"count":60,"path":61},"2019/12",3,"archives/2019/12",{"label":63,"count":13,"path":64},"2019/11","archives/2019/11",{"label":66,"count":13,"path":67},"2019/10","archives/2019/10",{"label":69,"count":60,"path":70},"2019/09","archives/2019/09",{"label":72,"count":13,"path":73},"2019/02","archives/2019/02",{"label":75,"count":13,"path":76},"2018/03","archives/2018/03",{"label":78,"count":13,"path":79},"2017/10","archives/2017/10",{"label":81,"count":19,"path":82},"2017/05","archives/2017/05",{"label":84,"count":33,"path":85},"2017/03","archives/2017/03"],"uses":{"params":["path"]}}]}
